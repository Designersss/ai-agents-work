{
  "name": "@aimock/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/domain/*.test.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "auth:migrate": "pnpm dlx auth@latest migrate --config src/auth.ts",
    "seed:credit": "tsx scripts/seed-credit.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ai": "^7.0.169",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "zod": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/express": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
