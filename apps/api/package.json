{
  "name": "@vimla/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "dotenv -e ../../.env -- pnpm dlx @better-auth/cli@1.7.20 migrate --config src/auth.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.20",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
