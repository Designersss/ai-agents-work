# Local development only — copy into .env if using the local Mailpit service.
# NEVER use this file for production.
DATABASE_URL=postgresql://vimla:local_dev_only@127.0.0.1:5433/vimla
BETTER_AUTH_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS_GENERATED_WITH_OPENSSL
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Mailpit is reachable on your Mac at 127.0.0.1:1025.
# Messages appear ONLY in the local inbox http://localhost:8025.
# They are not sent to real external email addresses.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Vimla Local <no-reply@local.vimla.test>"
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
