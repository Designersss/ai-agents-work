# Скопировать в .env; в production использовать настоящие секреты из secret manager.
DATABASE_URL=postgresql://vimla:local_dev_only@127.0.0.1:5433/vimla
BETTER_AUTH_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS_GENERATED_WITH_OPENSSL
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Реальный SMTP. Для локальной проверки можно использовать собственный SMTP;
# CI использует изолированный Mailpit. Без рабочего SMTP письма не доставятся.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
