# Secrets must stay in .env (gitignored) or in your deployment secret manager.
# This example contains NO real keys or user information.
DATABASE_URL=postgresql://vimla:local_dev_only@127.0.0.1:5433/vimla
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Real transactional delivery through Resend SMTP (https://resend.com).
# 1. Verify a domain you own under Resend -> Domains (SPF/DKIM).
# 2. Create a sending-access API key restricted to that verified domain.
# 3. Set SMTP_PASSWORD to that key and SMTP_FROM to an address at your domain.
# Do NOT use onboarding@resend.dev or a fake/unverified domain for real users.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=true
